# Caelia Motherboard Backend — environment template
# Copy to .env and fill in. NEVER commit a real .env.
# Alicia supplies real values at deploy time, typed by her own hands.

# Owner auth token — long random string. All /api/* routes require it as
#   Authorization: Bearer <OWNER_TOKEN>
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
OWNER_TOKEN=PASTE_LONG_RANDOM_TOKEN_HERE

# Port the server listens on
PORT=8787

# SQLite file location (created automatically)
DB_PATH=./data/motherboard.sqlite

# Local file storage directory for uploads
STORAGE_DIR=./storage

# --- Backend Safe (encrypted vault) ---
# Master passphrase for the Backend Safe. Unlocks the 5 vault containers
# (caelia-tokens, caelia-keys, motherboard-keys, backend-credentials, toms-box).
# Without this, every vault endpoint fails closed (503 VAULT_LOCKED).
# Alicia types this herself at deploy. NEVER in chat, never committed.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
VAULT_MASTER_KEY=PASTE_LONG_RANDOM_PASSPHRASE_HERE

# --- QuantVantage evaluation engine (bundled Python runner) ---
# ANTHROPIC_API_KEY enables LIVE AI evaluations through the bundled runner.
# Without it, the engine honestly reports ENGINE_NEEDS_KEY — nothing is faked.
# Alicia types this herself at deploy. NEVER in chat, never committed.
ANTHROPIC_API_KEY=PASTE_ANTHROPIC_KEY_HERE
# STRIPE_SECRETS_KEY is optional — only needed for paid report-unlock
# verification. Evaluations run without it.
STRIPE_SECRETS_KEY=
# Python interpreter for the bundled evaluator (default: python3)
QV_PYTHON=python3

# --- Discord bot (interface, not the brain) ---
# Discord is a Server 2 interface to Alicia's "caelia server" — it is NOT
# Caelia's brain. The bot token lives in the Backend Safe, NOT here:
#   POST /api/vault/secrets  { container: "backend-credentials",
#                              name: "discord-bot-token", value: "<token>" }
# Alicia creates the bot at discord.com/developers herself and types the
# token in via the vault endpoint. NEVER in chat, never committed.
# Without a stored token the bot reports DISCORD_NEEDS_TOKEN and everything
# else keeps running.
# Your Discord user ID (Alicia only — the bot takes commands from her alone).
# Get it: Discord Settings -> Advanced -> Developer Mode ON, then right-click
# your name -> Copy User ID.
DISCORD_OWNER_ID=
# Server (guild) ID: right-click the "caelia server" -> Copy Server ID.
DISCORD_GUILD_ID=
# Channel IDs: right-click each channel -> Copy Channel ID.
DISCORD_CHANNEL_VOICE=
DISCORD_CHANNEL_PRIVATE=
DISCORD_CHANNEL_AGENTS=
DISCORD_CHANNEL_OPS=

# --- Future / Kallel integration (leave blank until wired) ---
# Caelia Brain service base URL (set when the Brain backend is deployed)
CAELIA_BRAIN_URL=
# Credential vault reference for the Action Bridge (a NAME, never a secret).
# The backend only ever stores vault *references*; raw secrets live in the
# vault itself and are resolved server-side at deploy time by Alicia.
CREDENTIAL_VAULT_REF=
# QuantVantage engine endpoint (wired by Kallel during integration)
QV_ENGINE_URL=

# Exact browser origins, comma-separated. Do not use * in production.
DASHBOARD_ORIGINS=https://your-dashboard.example
# Optional request body limit (Express syntax)
MAX_BODY_BYTES=2mb
